# ─── Copie este archivo a .env.local y complete los valores. NUNCA commitee .env*. ───

# URL pública definitiva (sin barra final). TODO(owner): dominio real.
NEXT_PUBLIC_SITE_URL=https://www.maviproyectos.com

# ── Correo de cotizaciones (Resend: https://resend.com) ──
# Clave de API con permiso solo de envío ("Sending access").
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, p. ej. "MAVI Web <cotizaciones@maviproyectos.com>"
QUOTE_FROM_EMAIL=
# Destinatarios separados por coma
QUOTE_TO_EMAIL=maviproyectoseinversiones@gmail.com

# ── Anti-spam: Cloudflare Turnstile (opcional pero recomendado) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limit global: Upstash Redis REST (recomendado en producción) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Sal para hashear IPs en las claves de rate limit (cadena aleatoria larga)
RATE_LIMIT_SALT=

# ── Analítica sin cookies (opcional) ──
# Host de Plausible/Umami self-hosted, p. ej. https://analitica.maviproyectos.com
NEXT_PUBLIC_PLAUSIBLE_HOST=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
