# Bloquea el commit si secretlint detecta claves o tokens en los archivos preparados.
archivos=$(git diff --cached --name-only --diff-filter=ACM | grep -v -E '\.(woff2|ttf|pdf|jpg|png|webp|avif)$|pnpm-lock\.yaml$' || true)
[ -z "$archivos" ] && exit 0
echo "$archivos" | tr '\n' '\0' | xargs -0 node ./node_modules/secretlint/bin/secretlint.js --secretlintignore .secretlintignore
